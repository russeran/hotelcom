# Copy this file to .env and fill in the values. .env is gitignored.

# --- Backend (Express) ---
# MongoDB connection string
DATABASE_URL=mongodb://127.0.0.1:27017/hotelcom
# Secret used to sign/verify JWTs
SECRET=change_me
# Port the API server listens on (React dev server proxies /api here)
PORT=3001

# --- Frontend (Create React App) ---
# NOTE: REACT_APP_* values are embedded into the client bundle at build time
# and are therefore visible to end users. Use keys that are safe to expose
# client-side (e.g. rate-limited demo keys), not privileged secrets.

# OpenWeatherMap API key (Weather widget on the Home page)
REACT_APP_OPENWEATHER_KEY=
# RapidAPI key for hotels-com-provider (Other Hotels page)
REACT_APP_RAPIDAPI_KEY=

# --- Server-side third-party keys (NOT exposed to the client) ---
# Ticketmaster Discovery API key — powers the Concierge "Events Happening
# Nearby" section (free key: https://developer.ticketmaster.com/). Optional;
# when unset the events section simply shows a prompt to connect it.
TICKETMASTER_API_KEY=

# OpenAI API key — powers the AI Concierge chat feature (GPT-4o-mini).
# Get your key from https://platform.openai.com/api-keys
# Cost: ~$0.15-0.60 per 1M tokens (~$0.01 per conversation)
# Optional; when unset the AI Concierge will show an error message.
OPENAI_API_KEY=
